PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/restaurant
CLIENT_URL=http://localhost:3000
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
ADMIN_NAME=Super Admin
ADMIN_PHONE=08012345678
ADMIN_PASSWORD=ChangeThisNow123

# Tax and pricing
VAT_RATE=0.075
# exclusive = added on top, inclusive = menu prices already include VAT, none = no VAT
VAT_MODE=exclusive

# Paystack (use sk_test_... while testing)
PAYSTACK_SECRET_KEY=
# Customers who sign up with only a phone get an email like 23480...@this-domain
PAYSTACK_FALLBACK_EMAIL_DOMAIN=yourrestaurant.com
# true = paid online orders skip "pending" and go straight to "confirmed"
AUTO_CONFIRM_PAID=false
